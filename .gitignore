# Only source, metadata and explicit test/example directories belong in this repository.
/*
!/.editorconfig
!/.gitattributes
!/.gitignore
!/LICENSE
!/README.md
!/Cargo.toml
!/Cargo.lock
!/rust-toolchain.toml
!/crates/
!/examples/

/crates/*
!/crates/wslc-runtime/
/crates/*/*
!/crates/*/Cargo.toml
!/crates/*/src/
!/crates/*/tests/
/crates/*/src/*
!/crates/*/src/*.rs
!/crates/*/src/bin/
!/crates/*/src/bin/*.rs
/crates/*/tests/*
!/crates/*/tests/*.rs

/examples/*
