# Only source, metadata and explicit test/example directories belong in this repository.
/*
!/.editorconfig
!/.gitattributes
!/.gitignore
!/LICENSE
!/README.md
!/Cargo.toml
!/Cargo.lock
!/rust-toolchain.toml
!/src/
!/tests/

/src/*
!/src/*.rs
!/src/bin/
/src/bin/*
!/src/bin/*.rs
/tests/*
!/tests/*.rs
